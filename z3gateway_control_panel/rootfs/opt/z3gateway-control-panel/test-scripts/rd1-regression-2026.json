     ],
     "matchers": [
      {
       "kind": "final_value",
       "attribute": "onOff",
       "value": true
      },
      {
       "kind": "in_range",
       "attribute": "currentLevel",
       "min": 1,
       "max": 253,
       "scope": "final"
      }
     ]
    },
    {
     "type": "confirm",
     "prompt": "确认：灯停在旋钮设定的亮度，没有继续渐亮到 100%，且读回的 currentLevel 与实际亮度相符"
    }
   ]
  }
 ]
}
