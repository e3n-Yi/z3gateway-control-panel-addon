   "id": "cli-gap-baseline",
   "number": "REG 0",
   "order": 9000,
   "title": "CLI 通道最小帧间隔基准",
   "notes": "记录本主机 CLI/PTY 通道能达到的最小帧间隔，用于判断其他时序用例是否可信。",
   "steps": [
    {
     "type": "write_attributes",
     "attributes": {
      "onLevel": 255,
      "onTransitionTime": 10,
      "offTransitionTime": 10,
      "options": 0
     }
    },
    {
     "type": "set_state",
     "on": true,
     "level": 128
    },
    {
     "type": "burst",
     "gap_ms": 0,
     "gap_tolerance_ms": 1000,
     "frames": [
      {
       "command": "move_to_level",
       "level": 120,
       "transition": 0
      },
      {
       "command": "move_to_level",
       "level": 128,
       "transition": 0
      }
     ]
    },
    {
     "type": "expect",
     "window_ms": 4000,
     "quiet_ms": 1500,
     "read_back": [
      "currentLevel"
     ],
     "matchers": [
      {
       "kind": "read_value",
       "value": 128,
       "tolerance": 1
      }
     ]
    }
   ]
  },
